// blk connects its leaves through implicit nets: n_* are not declared
module blk (
  input  logic       clk,
  output logic [7:0] y
);

  t_src u_src (
    .clk (clk),
    .e   (n_e),
    .ea  (n_ea),
    .i   (n_i),
    .u   (n_u),
    .v   (n_v),
    .r   (n_r),
    .s   (n_s),
    .f   (n_f),
    .cnt (n_cnt)
  );

  t_dst u_dst (
    .e  (n_e),
    .ea (n_ea),
    .i  (n_i),
    .u  (n_u),
    .v  (n_v),
    .r  (n_r),
    .s  (n_s),
    .f  (n_f),
    .y  (y)
  );

endmodule
