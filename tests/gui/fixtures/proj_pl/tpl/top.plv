// top: generated by prepro (perl flavor)
// pl $W = 8;
// pl $LANES = 2;
// pl my $D = 4;
module top
  (input  logic       clk,
   input  logic       rst_n,
   input  logic [7:0] din,
   output logic [7:0] dout);

   logic [7:0] a2b;
   logic [7:0] b2c;

   stage u_a (.clk(clk), .rst_n(rst_n), .d(din), .q(a2b), .busy());

   stage #(.W(#$W)) u_b (.clk(clk), .rst_n(rst_n), .d(a2b), .q(b2c), .busy());

   stage #(.W(#$D)) u_e (.clk(clk), .rst_n(rst_n), .d(b2c[3:0]), .q(dout[3:0]), .busy());
// pl for my $i (0 .. $LANES - 1) {

   stage u_lane#$i (.clk(clk), .rst_n(rst_n), .d(din), .q(), .busy());
// pl }

   assign dout[7:4] = b2c[7:4];
endmodule
