// top: generated by prepro (python flavor)
// py USE_D = True
// py LANES = 2
// py W = 8
module top
  (input  logic       clk,
   input  logic       rst_n,
   input  logic [7:0] din,
   output logic [7:0] dout,
   output logic       busy);

   logic [7:0] a2b;
   logic [7:0] b2c;
   logic [7:0] c2d;
   logic       b_busy;

   stage u_a (.clk(clk), .rst_n(rst_n), .d(din), .q(a2b), .busy());

   stage u_b (.clk(clk), .rst_n(rst_n), .d(a2b), .q(b2c), .busy(b_busy));

   stage #(.W(#$W)) u_c
     (.clk(clk), .rst_n(rst_n), .d(b2c), .q(c2d), .busy());
// py if USE_D:

   stage u_d (.clk(clk), .rst_n(rst_n), .d(c2d), .q(dout), .busy());
// py
// py for i in range(LANES):

   stage u_lane#$i (.clk(clk), .rst_n(rst_n), .d(din), .q(), .busy());
// py # end of lanes

   assign busy = b_busy;
endmodule
